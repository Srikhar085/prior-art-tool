# Copy this file to .env and fill in the keys you have.
# Any source without a key configured is skipped automatically.

# Free API key from https://patentsview.org/apis/keyrequest (US patents, full text)
PATENTSVIEW_API_KEY=

# Free consumer key/secret from https://developers.epo.org (international patents, EPO OPS)
EPO_OPS_KEY=
EPO_OPS_SECRET=

# No key required for Semantic Scholar (academic / non-patent literature), left here
# in case you have a key for higher rate limits: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# REQUIRED before deploying anywhere reachable outside your own machine.
# Gates the entire app behind HTTP Basic Auth so confidential ideas can't be
# searched or viewed by anyone who just has the URL.
#
# Recommended: one entry per colleague, generated with `python scripts/add_user.py`
# (each person's password is hashed on their own machine and never shared).
# Format: "email1:bcrypt_hash1,email2:bcrypt_hash2,..."
APP_USERS=

# Only used if APP_USERS is empty — a single shared login for quick solo
# local development. Leave both blank for local dev with no login at all.
APP_USERNAME=
APP_PASSWORD=

# Email domain enforced by scripts/add_user.py when generating a login.
REQUIRED_EMAIL_DOMAIN=bmwtechworks.in
