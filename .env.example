# Copy this file to .env and fill in the keys you have.
# Any source without a key configured is skipped automatically.

# Free API key from https://patentsview.org/apis/keyrequest (US patents, full text)
PATENTSVIEW_API_KEY=

# Free consumer key/secret from https://developers.epo.org (international patents, EPO OPS)
EPO_OPS_KEY=
EPO_OPS_SECRET=

# No key required for Semantic Scholar (academic / non-patent literature), left here
# in case you have a key for higher rate limits: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
